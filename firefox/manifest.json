{
  "manifest_version": 3,
  "name": "OriginFilter",
  "version": "0.6.0",
  "description": "Local English-language and evidence-based account-country filters for X, Facebook and YouTube. Country coverage is limited.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://*.x.com/*",
    "https://*.twitter.com/*",
    "https://*.facebook.com/*",
    "https://*.youtube.com/*"
  ],
  "icons": {
    "48": "icons/icon-48.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "48": "icons/icon-48.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.x.com/*",
        "https://*.twitter.com/*",
        "https://*.facebook.com/*",
        "https://*.youtube.com/*"
      ],
      "js": [
        "core.js",
        "adapters.js",
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_start"
    }
  ],
  "background": {
    "scripts": [
      "core.js",
      "background.js"
    ]
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "originfilter@rarediary.dev",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ],
        "optional": [
          "websiteContent"
        ]
      }
    }
  }
}
